[career_quest]
provider = "bailian"
api_key = "YOUR_API_KEY"
model = "qwen-plus"
# If your key has a workspace-specific URL, copy that complete compatible URL.
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# voice_api_key = "YOUR_OPTIONAL_OPENAI_TTS_KEY"

[hosting]
whisper_model = "base"
daily_api_limit = 200
